<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 Permanent Redirects
  RewriteRule ^panduan/cannibalization-keyword/?$ /panduan/kanibalisasi-keyword [R=301,L]
  RewriteRule ^panduan/schema-markup/?$ /panduan/structured-data-ai [R=301,L]
  RewriteRule ^panduan/conversion-rate/?$ /panduan/tingkat-konversi-cvr [R=301,L]
  RewriteRule ^panduan/static-site-generation/?$ /panduan/ssg-ssr-csr [R=301,L]
  RewriteRule ^jasa-pembuatan-website-jakarta-selatan/?$ /jasa-pembuatan-website-jakarta [R=301,L]
  RewriteRule ^industries/hospitality/?$ /industries/hotel [R=301,L]
  RewriteRule ^industries/culinary/?$ /industries/restaurant [R=301,L]
  RewriteRule ^industries/education/?$ /industries/school [R=301,L]
  RewriteRule ^industries/fishery/?$ /industries/agriculture [R=301,L]
  RewriteRule ^industries/textile/?$ /industries/fashion [R=301,L]
  RewriteRule ^industries/furniture/?$ /industries/interior-design [R=301,L]
  RewriteRule ^industries/footwear/?$ /industries/manufacturing [R=301,L]
  RewriteRule ^industries/mining/?$ /industries/engineering [R=301,L]
  RewriteRule ^industries/maritime/?$ /industries/logistics [R=301,L]

  # Security: Block access to git and source code
  RewriteRule ^(\.git|\.env|node_modules|src|package\.json|package-lock\.json|tsconfig\.json|next\.config\.ts) - [F,L]

  # 1. Root / -> out/index.html
  RewriteRule ^$ out/index.html [L]

  # 2. Existing files inside out/ (CSS, JS, images, sitemap.xml, robots.txt)
  RewriteCond %{DOCUMENT_ROOT}/out/$1 -f [OR]
  RewriteCond out/$1 -f
  RewriteRule ^(.*)$ out/$1 [L]

  # 3. Clean HTML routes (e.g. /website-packages -> out/website-packages.html)
  RewriteCond %{DOCUMENT_ROOT}/out/$1.html -f [OR]
  RewriteCond out/$1.html -f
  RewriteRule ^(.*)/?$ out/$1.html [L]

  # 4. Clean Directory HTML routes (e.g. /demos/modern-corporate/ -> out/demos/modern-corporate/index.html)
  RewriteCond %{DOCUMENT_ROOT}/out/$1/index.html -f [OR]
  RewriteCond out/$1/index.html -f
  RewriteRule ^(.*)/?$ out/$1/index.html [L]
</IfModule>

# Custom 404 Error
ErrorDocument 404 /out/_not-found.html

# Directory Index fallback
DirectoryIndex index.php out/index.html index.html

# Prevent indexing of Next.js RSC payload .txt files, allow llms.txt
<IfModule mod_headers.c>
  <FilesMatch "\.txt$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
  <FilesMatch "(llms\.txt|llms-full\.txt)$">
    Header unset X-Robots-Tag
  </FilesMatch>
</IfModule>
